# Bu dosya şablondur, gerçek değer içermez. Kopyalayıp .env olarak doldurun.
# Vercel'de aynı anahtarlar proje ayarlarındaki Environment Variables bölümüne girilir.

# --- Veritabanı (Neon) -------------------------------------------------------
# Uygulama havuzlanmış (-pooler) bağlantıyı kullanır.
DATABASE_URL="postgresql://kullanici:parola@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Migration ve şema işlemleri havuzlanmamış bağlantı ister.
DIRECT_URL="postgresql://kullanici:parola@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Site --------------------------------------------------------------------
# Kanonik adres, sitemap ve mutlak bağlantılar buradan üretilir. Sonunda / olmamalı.
NEXT_PUBLIC_SITE_URL="https://www.kiymetveteriner.com"

# --- Yönetim paneli girişi ---------------------------------------------------
# AUTH_SECRET üretmek için: openssl rand -base64 32
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- E-posta bildirimi (Resend) ----------------------------------------------
RESEND_API_KEY=""
# Alan adı doğrulanana dek onboarding@resend.dev yalnızca hesap sahibine gönderir.
NOTIFY_FROM_EMAIL="randevu@kiymetveteriner.com"
# Yeni randevu bildiriminin düşeceği klinik adresi.
NOTIFY_TO_EMAIL=""

# --- WhatsApp (isteğe bağlı) -------------------------------------------------
# Boş bırakılırsa WhatsApp bildirimi sessizce atlanır, randevu yine oluşur.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="randevu_bildirimi"
